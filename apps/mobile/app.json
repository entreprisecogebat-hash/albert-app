{
  "expo": {
    "name": "Albert",
    "slug": "albert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.albert.chantier",
      "infoPlist": {
        "NSCameraUsageDescription": "Albert utilise l'appareil photo pour ajouter des photos au chantier.",
        "NSLocationWhenInUseUsageDescription": "Albert note la position de chaque photo pour prouver où elle a été prise.",
        "NSPhotoLibraryUsageDescription": "Albert accède à vos photos pour les ajouter au chantier."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2C3138",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.albert.chantier",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "albert",
    "backgroundColor": "#FAFAFA",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      "expo-web-browser"
    ]
  }
}
